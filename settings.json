{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "GRADLE_OPTS": "-Dorg.gradle.daemon=true -Dorg.gradle.parallel=true -Dorg.gradle.caching=true",
    "PAGER": "cat",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_EDITOR": "true",
    "HOMEBREW_NO_AUTO_UPDATE": "1"
  },
  "permissions": {
    "deny": [
      "Edit(**/.claude/settings*.json)",
      "Edit(~/.claude/hooks/**)",
      "Read(~/.claude.json)",
      "Edit(~/.claude.json)",
      "Read(~/.pypirc)",
      "Edit(~/.pypirc)",
      "Read(~/.m2/settings.xml)",
      "Edit(~/.m2/settings.xml)",
      "Read(~/.config/op/**)",
      "Edit(~/.config/op/**)",
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.git-credentials)",
      "Edit(~/.git-credentials)",
      "Read(~/.config/gh/**)",
      "Edit(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Read(~/.cargo/credentials*)",
      "Edit(~/.cargo/credentials*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Read(**/.env.production)",
      "Edit(**/.env.production)",
      "Read(**/.env.development)",
      "Edit(**/.env.development)",
      "Read(**/.env.*.local)",
      "Edit(**/.env.*.local)",
      "Read(~/.gradle/gradle.properties)",
      "Edit(~/.gradle/gradle.properties)",
      "Edit(**/local.properties)",
      "Read(**/keystore.properties)",
      "Edit(**/keystore.properties)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/*.jks)",
      "Edit(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(**/*.keystore)",
      "Edit(~/.zshrc)",
      "Edit(~/.zshenv)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "~/super",
      "~/Library/Android/sdk",
      "~/.gradle",
      "~/.cargo",
      "~/.rustup",
      "~/Library/Developer",
      "~/Library/pnpm",
      "~/Library/Java/JavaVirtualMachines",
      "/tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-bash.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(use_figma|create|batch|delete|upload_assets|generate_figma_design|create_.*|update_.*|delete_.*|modify_.*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-mcp.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/format-edited.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules"
    ],
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "zsh ~/.claude/statusline-command.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "language": "zh-CN",
  "effortLevel": "medium",
  "tui": "default",
  "autoMemoryEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "wheelScrollAccelerationEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "autoConnectIde": true,
  "diffTool": "auto"
}
