{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "GRADLE_OPTS": "-Dorg.gradle.daemon=true -Dorg.gradle.parallel=true -Dorg.gradle.caching=true",
    "PAGER": "cat",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_EDITOR": "true",
    "HOMEBREW_NO_AUTO_UPDATE": "1"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit(*)",
      "Write(*)",
      "WebFetch"
    ],
    "deny": [
      "Edit(~/.claude/settings*.json)",
      "Write(~/.claude/settings*.json)",
      "Edit(**/.claude/settings*.json)",
      "Write(**/.claude/settings*.json)",
      "Edit(~/.claude/hooks/**)",
      "Write(~/.claude/hooks/**)",
      "Read(~/.npmrc)",
      "Write(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Read(~/.netrc)",
      "Write(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Write(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Write(~/.docker/config.json)",
      "Read(~/.cargo/credentials*)",
      "Write(~/.cargo/credentials*)",
      "Read(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Write(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.kube/**)",
      "Write(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Write(~/.gnupg/**)",
      "Read(**/.env)",
      "Write(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Write(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(~/.gradle/gradle.properties)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Write(**/*.jks)",
      "Edit(**/*.jks)",
      "Read(**/*.keystore)",
      "Write(**/*.keystore)",
      "Edit(**/*.keystore)",
      "Write(~/.zshrc)",
      "Edit(~/.zshrc)",
      "Write(~/.zshenv)",
      "Edit(~/.zshenv)",
      "Bash(mkfs*)",
      "Bash(dd *of=/dev/*)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "~/super",
      "~/Library/Android/sdk",
      "~/.gradle",
      "~/.cargo",
      "~/.rustup",
      "~/Library/Developer",
      "~/Library/pnpm",
      "~/Library/Java/JavaVirtualMachines",
      "/tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/format-edited.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules"
    ],
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "zsh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "language": "zh-CN",
  "effortLevel": "medium",
  "tui": "default",
  "autoMemoryEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "wheelScrollAccelerationEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "autoConnectIde": true,
  "diffTool": "auto"
}
