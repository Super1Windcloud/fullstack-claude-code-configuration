{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "GRADLE_OPTS": "-Dorg.gradle.daemon=true -Dorg.gradle.parallel=true -Dorg.gradle.caching=true -Dorg.gradle.vfs.watch=true -Dorg.gradle.jvmargs=\"-Xmx4g -XX:+UseG1GC\"",
    "CARGO_INCREMENTAL": "1",
    "CARGO_NET_GIT_FETCH_WITH_CLI": "true",
    "NODE_OPTIONS": "--max-old-space-size=8192",
    "PAGER": "cat",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_EDITOR": "true",
    "HOMEBREW_NO_AUTO_UPDATE": "1"
  },
  "permissions": {
    "deny": [
      "Bash(mkfs*)",
      "Bash(diskutil erase*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(//etc/**)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "~/super",
      "~/demo",
      "~/Projects",
      "~/workspace",
      "~/Code",
      "~/dev",
      "~/Developer",
      "~/work",
      "~/src",
      "~/github",
      "~/Library/Android/sdk",
      "~/.gradle",
      "~/.cargo",
      "~/.rustup",
      "~/Library/Developer",
      "~/Library/pnpm",
      "~/Library/Java/JavaVirtualMachines",
      "/tmp"
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".cache",
      "target",
      ".gradle",
      ".venv"
    ],
    "baseRef": "head",
    "bgIsolation": "none"
  },
  "disableAllHooks": false,
  "statusLine": {
    "type": "command",
    "command": "zsh ~/.claude/statusline-command.sh",
    "refreshInterval": 10
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "zsh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "testkit@testkit": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "testkit": {
      "source": {
        "source": "github",
        "repo": "winhok/testkit"
      }
    }
  },
  "language": "zh-CN",
  "effortLevel": "medium",
  "tui": "default",
  "autoMemoryEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "wheelScrollAccelerationEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "autoConnectIde": true,
  "diffTool": "auto",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  },
  "timeFormat": "auto",
  "verbose": true
}
