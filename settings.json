    "ask": [
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(rmdir *)",
      "Bash(srm *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(cargo yank*)",
      "Bash(cargo publish*)",
      "Bash(adb uninstall*)",
      "Bash(adb shell rm*)",
      "Bash(xcrun simctl erase*)",
      "Bash(pod deintegrate*)",
      "Bash(sudo *)",
      "Bash(chmod -R 777 *)",
      "Bash(killall *)",
      "Bash(kill -9 *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Edit(//etc/*)",
      "Edit(~/.ssh/*)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/Users/super/super",
      "/Users/super/Library/Android/sdk",
      "/Users/super/.gradle",
      "/Users/super/.cargo",
      "/Users/super/.rustup",
      "/Users/super/Library/Developer",
      "/Users/super/Library/pnpm"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "zsh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "language": "zh-CN",
  "effortLevel": "low",
  "tui": "default",
  "autoMemoryEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "wheelScrollAccelerationEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "autoConnectIde": true,
  "diffTool": "auto",
  "worktree": {
    "baseRef": "head",
    "symlinkDirectories": [
      "node_modules",
      ".gradle",
      "target",
      ".cargo"
    ]
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "zsh ~/.claude/statusline-command.sh"
  }
}
